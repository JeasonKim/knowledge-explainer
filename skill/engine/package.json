{
  "name": "knowledge-explainer-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic runtime for illustrated knowledge explainer videos.",
  "scripts": {
    "dev": "remotion studio packages/renderer/src/index.ts --public-dir workspace-template/assets",
    "generate:contracts": "tsx scripts/export-agent-contracts.ts",
    "generate:studio-preview": "tsx scripts/generate-studio-preview.ts",
    "transcribe:audio-directory": "tsx scripts/transcribe-audio-directory.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@remotion/cli": "4.0.490",
    "@remotion/zod-types": "4.0.490",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.490",
    "yaml": "^2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
